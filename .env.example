# =============================================================================
#  Aziv AI — environment
# =============================================================================
#  Copy this file to .env and fill it in. NOTHING IN HERE IS A SECRET YET: the
#  values below are placeholders, and the real ones are typed on the server and
#  never committed.
#
#  Two rules that are worth more than the rest of this file:
#
#    1. `php artisan aziv:diagnose` tells you what is still wrong, in order of
#       how much it matters, and whose problem each one is. Run it after every
#       change here. It is the checklist.
#    2. API keys, model prices, plans, tax rates and payment credentials are
#       NOT in this file. They are entered in the admin panel, encrypted at
#       rest. Only the things a server needs before the panel can open live
#       here.
# =============================================================================

# -- Identity -----------------------------------------------------------------
APP_NAME="Aziv AI"

# `production` is not cosmetic: it is what turns the diagnostics from advice
# into blockers, and what makes a debug screen a launch-stopping failure.
APP_ENV=production

# Leave EMPTY and run `php artisan key:generate` once. Then back it up
# somewhere other than this server. THE DATABASE CANNOT BE RESTORED WITHOUT IT:
# every provider key, gateway credential and webhook secret is encrypted under
# this key, and a restore with a new one leaves them permanently unreadable.
APP_KEY=

# NEVER true on a live server. A debug page prints the environment — including
# this file — to whoever triggered the error.
APP_DEBUG=false

# The address customers actually type, WITH the scheme. Signed links — password
# resets, email verification, renewal payment links — are generated from this
# by the scheduler and the queue, where there is no request to infer it from.
# Getting the scheme wrong here breaks every one of them.
APP_URL=https://example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# -- Behind a proxy -----------------------------------------------------------
# Set this if ANYTHING terminates TLS in front of PHP — Cloudflare, a load
# balancer, nginx. Without it the application sees the plain HTTP hop behind
# the proxy, and every signed link 403s on a URL that is perfectly valid.
#
#   *                  behind Cloudflare or a managed load balancer, whose
#                      addresses change without notice
#   10.0.0.1,10.0.0.2  a fixed proxy you control
#   (empty)            no proxy at all — trust nothing
TRUSTED_PROXIES=*

# -- Database -----------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=aziv
DB_USERNAME=aziv
DB_PASSWORD=

# -- Sessions and cookies -----------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120

# TRUE ON ANY SITE SERVED OVER HTTPS. False sends the session cookie over plain
# HTTP too, where anything between the customer and the server can read it and
# become them.
SESSION_SECURE_COOKIE=true

# `lax` lets the cookie travel on the return leg from a payment gateway, which
# `strict` would drop — leaving the customer signed out on the page that tells
# them their payment worked.
SESSION_SAME_SITE=lax
SESSION_HTTP_ONLY=true

# Encrypt the session payload at rest. Worth it wherever the session store is
# shared, and cheap everywhere.
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

# -- Queues, cache, filesystem ------------------------------------------------
# Every long operation is a queued job: indexing a document, sending email,
# reconciling a payment. THE QUEUE MUST BE RUNNING or none of them happen.
# A worker where you have one, cron where you do not — see docs/11-deployment.md.
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# `auto` detects shared hosting and degrades in speed, never in capability.
AZIV_DEPLOYMENT_MODE=auto
# `auto` falls back from streaming to a single response when the host buffers
# output. Force `off` if your host buffers and detection cannot tell.
AZIV_STREAMING_MODE=auto

# -- Logging ------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
# `debug` on a live server writes a great deal, some of it about requests that
# failed. `error` is the setting for production.
LOG_LEVEL=error

# -- Email --------------------------------------------------------------------
# THE MOST EXPENSIVE THING IN THIS FILE TO GET WRONG, because getting it wrong
# looks exactly like getting it right. Laravel's default mailer is `log`: every
# message "sends", every delivery records as sent, and nothing reaches anybody.
# A renewal notice that goes to a log file is a subscription that lapses in
# silence.
#
# So this ships as `smtp` with the credentials blank, which FAILS LOUDLY until
# it is configured. Fill in the four values your mail provider gave you, then
# prove it with a real send:
#
#     php artisan aziv:mail:test you@yourdomain.com
#
# That command sends the same email a customer gets, through the same mailer,
# and never prints a credential. `log` is correct on a developer's machine and
# nowhere else.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# `tls` on port 587, `smtps` on port 465. Ask your provider which they want.
MAIL_SCHEME=tls
# Must be an address at a domain whose SPF and DKIM records you control, or
# most of what you send will be filed as spam.
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# -- Optional: Redis ----------------------------------------------------------
# Faster where it exists; the database drivers above are complete without it.
# To use it, set CACHE_STORE, SESSION_DRIVER and QUEUE_CONNECTION to `redis`.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# -- Optional: S3-compatible storage ------------------------------------------
# Only needed if uploads and knowledge-base files live off this server.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
